generator client {
  provider = "prisma-client"
  output   = "./src"
}

datasource db {
  provider = "postgresql"
  schemas  = ["ui_manage"]
}

enum UserRole {
  ADMIN
  USER

  @@schema("ui_manage")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@schema("ui_manage")
}

model User {
  id             String     @id
  account        String     @unique
  password       String
  displayName    String
  phone          String?
  role           UserRole   @default(USER)
  status         UserStatus @default(ACTIVE)
  token          String?    @unique
  tokenExpiredAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt
  email          String?

  @@map("users")
  @@schema("ui_manage")
}

model Design {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  ownerAccount String   @map("owner_account")
  objectKey    String   @unique @map("object_key")
  byteSize     Int?     @map("byte_size")
  shareToken   String?  @unique @map("share_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([ownerAccount])
  @@map("designs")
  @@schema("ui_manage")
}
