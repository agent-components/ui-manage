{
  "name": "ui-manage",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @ui-manage/server dev",
    "dev:web": "cd vendor/open-pencil && npx vite --host 0.0.0.0 --port 5173 --strictPort",
    "editor:install": "cd vendor/open-pencil && bun install",
    "build": "pnpm --filter @ui-manage/server build",
    "pack": "bash scripts/pack.sh",
    "preview": "pnpm --filter @ui-manage/server preview",
    "db:init": "pnpm --filter @ui-manage/prisma run init-admin",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "prisma:generate": "prisma generate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^18.0.10",
    "prisma": "^7.10.1"
  }
}