DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/harness

# Harness 宿主：SSO 兑换与组件登记
HARNESS_ORIGIN=https://harness.example.com
HARNESS_COMPONENT_ID=ui

# Sealos / MinIO S3 兼容对象存储
S3_ENDPOINT=https://objectstorageapi.gzg.sealos.run
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# 设为 1 才挂载 POST /mcp。不设置则没有 MCP 服务。
# MCP_ENABLE=1
